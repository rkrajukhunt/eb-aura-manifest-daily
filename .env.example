# Aura — environment variable NAMES only. Never commit values.
# Mobile values live in EAS secrets per profile; backend values in the host's env (see docs/technical/16-DEPLOYMENT.md).
# Copy to .env.local (mobile) / .env (backend) and fill in locally.

# ─── Mobile (apps/mobile) ────────────────────────────────────────────────
# Public by design — RLS is the security boundary, not these keys.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Backend base URL for this environment, e.g. http://localhost:3000
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_POSTHOG_KEY=
# RevenueCat iOS SDK key (Phase 10). Publishable by design — entitlements are
# verified against RevenueCat, not against this key. Unset = everyone free-tier,
# which is the documented degradation for a build with no RC project (12 §2).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
# The Play Store counterpart. RevenueCat issues one key PER STORE and the iOS
# key is rejected by the Android SDK, so this is required for billing on
# Android — same free-tier degradation while unset.
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
SENTRY_DSN_MOBILE=
# Set to `true` locally: `expo run:ios` otherwise fails at the source-map upload
# step (exit 65) because sentry-cli has no org/auth token. Release builds leave
# this unset and supply SENTRY_ORG/SENTRY_PROJECT/SENTRY_AUTH_TOKEN via EAS secrets.
SENTRY_DISABLE_AUTO_UPLOAD=true

# ─── Build-time (apps/mobile, read by app.config.ts) ─────────────────────
# Selects the build variant: development | staging | production. Drives the
# bundle-id suffix so all three can coexist on one device. Defaults to development.
APP_ENV=development
# Populated by `eas init`; leave blank until the founder creates the EAS project.
EAS_PROJECT_ID=
# Path to the FCM `google-services.json` for Android push (11 §2). This file IS
# a credential — keep it out of git and point at it from here. Unset = the
# Android build has no push transport; everything else runs normally.
GOOGLE_SERVICES_JSON=

# ─── Backend (apps/backend) ──────────────────────────────────────────────
SUPABASE_URL=
# Service role key — server only. Never ships to the client.
SUPABASE_SERVICE_ROLE_KEY=

# LLM provider abstraction switch (docs/technical/08-AI-ARCHITECTURE.md).
# Launch vendor: openai. Use `mock` for local dev and tests — no network, no spend.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
# Per-tier model ids, pinned by the Phase 5 bake-off (08 §2). Defaults in the
# env schema; override here after the bake-off.
LLM_MODEL_FLAGSHIP=
LLM_MODEL_MID=
LLM_MODEL_MINI=

# TTS provider (docs/technical/10-AUDIO-TTS.md). Use `mock` locally.
TTS_PROVIDER=mock
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Shared secret header on the RevenueCat webhook (Phase 10). The endpoint is
# @Public(), so this IS its authentication — and it FAILS CLOSED: unset means
# every webhook is rejected rather than accepted.
REVENUECAT_WEBHOOK_AUTH=
# RevenueCat SERVER key (secret, never ships to the client). Used only to delete
# the subscriber on account deletion (03 §5 step 3). Unset = that step is skipped.
REVENUECAT_SECRET_KEY=

# Tunable limits (04 §6). Defaults live in `@aura/shared` LIMITS; set these only
# to override without a redeploy (product 20 Q4).
MANIFEST_WEEKLY_LIMIT=
REFINE_PER_MOMENT=
PREGEN_INACTIVE_SKIP_DAYS=
PREGEN_BUFFER_MINUTES=

POSTHOG_SERVER_KEY=
SENTRY_DSN_BACKEND=

# Runtime
NODE_ENV=development
PORT=3000

# ─── Live test suite (apps/backend, `pnpm test:live`) ────────────────────
# Needs the ANON key as well as the service-role one, to prove RLS blocks a real
# user client. `test/live/setup.ts` falls back to the standard Supabase local
# demo keys — public, identical on every machine, useless outside localhost — so
# this only needs setting when pointing the suite at a non-local project.
SUPABASE_ANON_KEY=
