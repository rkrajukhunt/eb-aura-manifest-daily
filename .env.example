# Aura — environment variable NAMES only. Never commit values.
# Mobile values live in EAS secrets per profile; backend values in the host's env (see docs/technical/16-DEPLOYMENT.md).
# Copy to .env.local (mobile) / .env (backend) and fill in locally.

# ─── Mobile (apps/mobile) ────────────────────────────────────────────────
# Public by design — RLS is the security boundary, not these keys.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Backend base URL for this environment, e.g. http://localhost:3000
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
SENTRY_DSN_MOBILE=
# Set to `true` locally: `expo run:ios` otherwise fails at the source-map upload
# step (exit 65) because sentry-cli has no org/auth token. Release builds leave
# this unset and supply SENTRY_ORG/SENTRY_PROJECT/SENTRY_AUTH_TOKEN via EAS secrets.
SENTRY_DISABLE_AUTO_UPLOAD=true

# ─── Backend (apps/backend) ──────────────────────────────────────────────
SUPABASE_URL=
# Service role key — server only. Never ships to the client.
SUPABASE_SERVICE_ROLE_KEY=

# LLM provider abstraction switch (docs/technical/08-AI-ARCHITECTURE.md).
# Launch vendor: openai. Use `mock` for local dev and tests — no network, no spend.
LLM_PROVIDER=mock
LLM_API_KEY=
# Exact model id is pinned by the Phase 5 bake-off (08 §2).
LLM_MODEL=

# TTS provider (docs/technical/10-AUDIO-TTS.md). Use `mock` locally.
TTS_PROVIDER=mock
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Shared secret header on the RevenueCat webhook (Phase 10).
REVENUECAT_WEBHOOK_AUTH=

POSTHOG_SERVER_KEY=
SENTRY_DSN_BACKEND=

# Runtime
NODE_ENV=development
PORT=3000
