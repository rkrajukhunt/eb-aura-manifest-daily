{
  "name": "@aura/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --dev-client",
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "doctor": "expo-doctor"
  },
  "dependencies": {
    "@aura/shared": "workspace:*",
    "@sentry/react-native": "~7.11.0",
    "@supabase/supabase-js": "^2.110.7",
    "@tanstack/react-query": "^5.101.2",
    "expo": "~57.0.7",
    "expo-constants": "~57.0.6",
    "expo-dev-client": "~57.0.6",
    "expo-font": "~57.0.1",
    "expo-linking": "~57.0.3",
    "expo-router": "~57.0.7",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.36.1",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-worklets": "0.10.0",
    "posthog-react-native": "^4.57.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@aura/config": "workspace:*",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.1",
    "@types/react": "~19.2.2",
    "eslint": "^9.19.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.2",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.7.3"
  },
  "prettier": "@aura/config/prettier",
  "expo": {
    "install": {
      "//": "Expo SDK 57 suggests typescript ~6.0.3, but the monorepo is pinned to 5.x: ts-jest@29 declares peer typescript '>=4.3 <6' and @nestjs/cli@11 pins 5.7.3, so bumping to 6 would break the backend and shared test suites. One TS version across all workspaces matters more than matching Expo's suggestion, and mobile typechecks clean on 5.9.x. Revisit when ts-jest supports TS 6.",
      "exclude": [
        "typescript"
      ]
    }
  }
}
