{
  "extends": "@aura/config/tsconfig/base.json",
  "compilerOptions": {
    // CommonJS so the NestJS backend can require() it; the Metro bundler handles
    // CJS on the mobile side without complaint.
    "module": "CommonJS",
    "moduleResolution": "Node",
    "isolatedModules": false,
    "types": ["node"],
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "coverage", "**/*.spec.ts"]
}
